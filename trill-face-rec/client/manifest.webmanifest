{
  "id": "/",
  "name": "Trill Face Rec",
  "short_name": "Trill",
  "description": "Fast, private, on-device face recognition with people management.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0f1c",
  "theme_color": "#0a0f1c",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live recognition", "url": "./#/live", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "People", "url": "./#/people", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Analyze photo", "url": "./#/upload", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
